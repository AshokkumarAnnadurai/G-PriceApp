PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# CORS Settings
FRONTEND_URL=http://localhost:3000,'http://192.168.1.6:3010','https://geekeyy-pricingapp.signatech.com'

# JWT Authentication
AUTH_JWT_SECRET=insert_a_secure_random_string_here
AUTH_JWT_ACCESS_TOKEN_EXPIRES_IN=1h
AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_JWT_VERIFICATION_TOKEN_EXPIRES_IN=10h
